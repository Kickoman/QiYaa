// Windows resources: application icon and version information.
// Configured by CMake (configure_file) into the build directory.
#include <winver.h>

IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/icons/qiyaa.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@, @PROJECT_VERSION_MINOR@, @PROJECT_VERSION_PATCH@, 0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@, @PROJECT_VERSION_MINOR@, @PROJECT_VERSION_PATCH@, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "QiYaa contributors"
            VALUE "FileDescription", "QiYaa - Winamp-style Yandex Music player"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "QiYaa"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "QiYaa.exe"
            VALUE "ProductName", "QiYaa"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
